<odoo>

  <record id="export_ecofi_view_inherit" model="ir.ui.view">
    <field name="name">Create Finance Export inherit</field>
    <field name="inherit_id" ref="ecoservice_financeinterface.export_ecofi_view"/>
    <field name="model">export.ecofi</field>
    <field name="type">form</field>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='journal_ids']" position="after">
        <field name="to_export"/>
      </xpath>
    </field>
  </record>

</odoo>
