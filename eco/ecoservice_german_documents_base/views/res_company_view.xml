<odoo>
  <data noupdate="1">
    <record id="base.main_company" model="res.company">
      <field name="external_report_layout_id" ref="ecoservice_german_documents_base.external_layout_german_documents"/>
    </record>
  </data>

  <data>
    <record id="view_company_form_inherited_ecoserivce_german_documents" model="ir.ui.view">
      <field name="name">res.company.form.inherited.ecoservice.german.documents</field>
      <field name="model">res.company</field>
      <field name="inherit_id" ref="base.view_company_form"/>
      <field name="arch" type="xml">
        <field name="phone" position="before">
          <field name="chief_executive_officer"/>
        </field>
      </field>
    </record>
    <record id="action_create_missing_template" model="ir.actions.server">
      <field name="name">create missing template</field>
      <field name="state">code</field>
      <field name="groups_id" eval="[(4, ref('base.user_admin'))]" />
      <field name="model_id" ref="base.model_res_company" />
      <field name="binding_model_id" ref="base.model_res_company" />
      <field name="code">
        record.create_missing_template()
      </field>
    </record>
  </data>
</odoo>
