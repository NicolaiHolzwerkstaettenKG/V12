<odoo>

  <record id="ir_cron_auto_datev_export_mail_daily" model="ir.cron">
    <field name="name">Auto send mail with Finance Export (Daily)</field>
    <field name="model_id" ref="model_auto_datev_export_config"/>
    <field name="active" eval="True"/>
    <field name="interval_number">1</field>
    <field name="interval_type">days</field>
    <field name="numbercall">-1</field>
    <field name="doall" eval="False"/>
    <field name="state">code</field>
    <field name="code">model.create_export_send_mail('daily')</field>
  </record>

  <record id="ir_cron_auto_datev_export_mail_weekly" model="ir.cron">
    <field name="name">Auto send mail with Finance Export (Weekly)</field>
    <field name="model_id" ref="model_auto_datev_export_config"/>
    <field name="active" eval="True"/>
    <field name="interval_number">1</field>
    <field name="interval_type">weeks</field>
    <field name="numbercall">-1</field>
    <field name="doall" eval="False"/>
    <field name="state">code</field>
    <field name="code">model.create_export_send_mail('weekly')</field>
  </record>

  <record id="ir_cron_auto_datev_export_mail_monthly" model="ir.cron">
    <field name="name">Auto send mail with Finance Export (Monthly)</field>
    <field name="model_id" ref="model_auto_datev_export_config"/>
    <field name="active" eval="True"/>
    <field name="interval_number">1</field>
    <field name="interval_type">months</field>
    <field name="numbercall">-1</field>
    <field name="doall" eval="False"/>
    <field name="state">code</field>
    <field name="code">model.create_export_send_mail('monthly')</field>
  </record>

</odoo>
