<odoo noupdate="1">

  <record id="email_template_auto_datev_export" model="mail.template">
    <field name="name">Auto Datev Export Mail</field>
    <field name="model_id" ref="ecoservice_financeinterface_datev.model_ecofi"/>
    <field name="email_from">{{ object.company_id.email }}</field>
    <field name="partner_to">{{ object.auto_datev_export.partner_id.id }}</field>
    <field name="lang">{{ object.auto_datev_export.partner_id.lang }}</field>
    <field name="body_html" type="html">
      <div style="margin: 0px; padding: 0px;">
        <p style="margin: 0px; padding: 0px; font-size: 13px;">
          Hello,<br/>
          <br/>
          <br/>
          Please find the latest financial export in the attached file.<br/>
          <br/>
          <br/>
          Regards,<br/>
         <t t-out="user.partner_id.name" />
        </p>
      </div>
    </field>
  </record>

</odoo>
